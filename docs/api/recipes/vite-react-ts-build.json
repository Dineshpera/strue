  "files": {},
  "steps": [
    "npm create vite@latest app -- --template react-ts",
    {
      "run": "npm install",
      "cwd": "app"
    },
    {
      "run": "npm run build",
      "cwd": "app"
    }
  ],
  "check": {
    "run": "test -f dist/index.html && echo strue-ok",
    "cwd": "app",
    "expect": "strue-ok"
  },
