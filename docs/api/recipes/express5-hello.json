{
  "id": "express5-hello",
  "title": "Express 5 server with a JSON route and a wildcard route",
  "intent": "Create an Express server with a JSON endpoint and a catch-all path segment.",
  "source": "https://expressjs.com/en/guide/migrating-5.html",
  "runtime": "node",
  "tags": [
    "node",
