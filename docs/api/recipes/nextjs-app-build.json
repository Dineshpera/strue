{
  "id": "nextjs-app-build",
  "title": "Next.js app created with create-next-app and built for production",
  "intent": "Create a new Next.js app with the default template and run a production build.",
  "source": "https://nextjs.org/docs/app/getting-started/installation",
  "runtime": "node",
  "tags": [
    "node",
    "nextjs",
    "react",
    "frontend"
  ],
  "notes": "The default template downloads Google Fonts during the build, so this needs open internet access.",
  "status": "verified",
  "inspected_on": "2026-11-17",
  "verified_streak_days": 5,
  "files": {},
  "steps": [
    "npx create-next-app@latest app --yes --use-npm",
    {
      "run": "npm run build",
      "cwd": "app"
    }
  ],
  "check": {
    "run": "test -d .next && echo strue-ok",
    "cwd": "app",
    "expect": "strue-ok"
  },
