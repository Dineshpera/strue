      "id": "langchain-core-chain",
      "title": "LangChain prompt-to-parser chain with current import paths",
      "intent": "Build a LangChain runnable chain from a chat prompt using langchain-core imports.",
      "source": "https://python.langchain.com/docs/concepts/lcel/",
      "runtime": "python",
      "tags": [
        "python",
        "langchain",
        "llm"
      ],
      "notes": "A stand-in function plays the model, so no API key is needed. The check proves the import paths and the pipe composition still work.",
      "status": "verified",
      "inspected_on": "2026-11-24",
      "verified_streak_days": 12,
      "files": {
        "check.py": "from langchain_core.messages import AIMessage\nfrom langchain_core.output_parsers import StrOutputParser\nfrom langchain_core.prompts import ChatPromptTemplate\nfrom langchain_core.runnables import RunnableLambda\n\nprompt = ChatPromptTemplate.from_messages(\n    [(\"system\", \"You are terse.\"), (\"human\", \"{question}\")]\n)\nfake_model = RunnableLambda(\n    lambda value: AIMessage(content=\"echo:\" + value.to_messages()[-1].content)\n)\nchain = prompt | fake_model | StrOutputParser()\nassert chain.invoke({\"question\": \"hi\"}) == \"echo:hi\"\nprint(\"strue-ok\")\n"
      },
      "steps": [
        "pip install langchain langchain-core"
